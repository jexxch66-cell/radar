{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/icons/**",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "public-images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/images/**"]
      }
    }
  ]
}
